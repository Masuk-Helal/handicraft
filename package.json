{
  "name": "handicraft",
  "version": "1.0.0",
  "private": true,
  "description": "Handicraft HTML site",
  "scripts": {
    "watch": "sass --watch assets/scss/main.scss:assets/css/style.css",
    "build": "sass assets/scss/main.scss:assets/css/style.css --no-source-map",
    "build:min": "sass assets/scss/main.scss:assets/css/style.min.css --style=compressed --no-source-map"
  },
  "devDependencies": {
    "sass": "^1.80.0"
  }
}
